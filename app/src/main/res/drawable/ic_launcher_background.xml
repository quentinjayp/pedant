<?xml version="1.0" encoding="utf-8"?>
<!--
  The app icon's background: bright orange at the top left, bright blue at the bottom right, each
  at full strength for a third of the visible icon with a short blend between. The gradient spans
  only the part launchers show (the middle 72 of 108).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90">
                <item android:offset="0.33" android:color="#FFFF7615" />
                <item android:offset="0.67" android:color="#FF159EFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
